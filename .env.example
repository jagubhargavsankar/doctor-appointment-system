# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/doctor_appointment_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace_with_your_mysql_password

# Generate a fresh Base64-encoded random secret of at least 32 bytes.
# Do not use the placeholder below as a real key.
JWT_SECRET=replace_with_generated_base64_secret
JWT_EXPIRATION_MS=3600000

# Initial admin is created only when both variables are supplied.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
# Groq AI
GROQ_API_KEY=replace_with_your_groq_api_key